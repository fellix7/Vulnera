# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Port for the API server
PORT=8787
# Set to 1 to serve OSV/EPSS responses only from data/snapshots (demo without network)
OFFLINE=0
# Gemini model used for advisory analysis (default: gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash-lite
# Gemini requests per minute. 4 fits the free tier (5/min per model); raise it (e.g. 60) with a paid key
GEMINI_RPM=4
